{
  "_editingGuide": {
    "purpose": "This file is the single master for the questionnaire the UI prototype renders. It is the literal input: every question, every answer option, and their order lives here and nowhere else. HOW TO APPLY AN EDIT: the page renders from an embedded copy of this file inside index.html (gate G-QM-1 keeps both copies identical) - so after editing here, the SAME content must be re-embedded into index.html before a reload shows your change. The canonical repo's sync step does that re-embed; editing this file alone will not change the page.",
    "how_order_works": "Question numbers (1..N) are derived automatically from the order of the entries in the items array. To reorder questions, move whole item objects up or down in items. To add a question, append a new item object. To remove one, delete its item object. Do not hand-number anything.",
    "how_to_add_an_item": "Copy any existing item object, change id (must be unique) and label, then edit you/seek options. Required fields per item: id, label, axis. An item with axis \"you\" or \"both\" needs a you object; axis \"seek\" or \"both\" needs a seek object.",
    "fields": {
      "id": "Stable identifier, also used as the HTML name attribute. Never rename an existing id once real users have answered into it.",
      "label": "Human text shown next to the question number.",
      "axis": "one of you (About you only), seek (Looking for only), both (symmetric: shows both sides).",
      "you": "About-you side. type radio (enum answer) or number (your age). options = list of value/label; the option with checked=true is the default. An option with checked omitted defaults to unchecked.",
      "seek": "Looking-for side. type radio (one choice), multi (several choices), or range (free-form min/max numbers). importance=true means it shows the 1-5 importance scale; importanceDefault is which dot is pre-selected. redflag=true means each option gets a private red-flag toggle. For type range, redflag renders a single outside-range flag.",
      "conditional": "null for normal items, or {when, showUnless} for items that hide based on another answer. The item is hidden whenever the When answer's value is in showUnless. Currently only the Kids item is conditional on the Looking-for goal being casual or undecided.",
      "hint": "Optional extra wording. On a you or seek side it renders right below that side; on the item itself it renders beneath the whole question."
    },
    "values_are_stable": "A value (for example woman, lt160, must-love) is a stable identifier. If you relabel an option (change label only), leave value unchanged so existing answers keep working. Change value only if you intend to break old answers.",
    "relabel_rule": "To relabel, edit the label string only. Labels may contain unicode characters (en-dash -, em-dash -, less-than sign). Keep option values as plain letters/digits/hyphens."
  },
  "_validation": {
    "age_bounds_18_99": "your-age and the age range keep min 18, max 99.",
    "height_bounds_120_250": "the height range keeps min 120, max 250 (centimetres).",
    "range_min_le_max": "For range items, min must not be greater than max. Empty bounds are allowed (open end). The UI checks this live.",
    "cannot_flag_all": "A Looking-for item cannot be red-flagged on every option; at least one choice must stay un-flagged. The UI enforces this on click.",
    "importance_1_to_5": "importanceDefault must be an integer from 1 to 5."
  },
